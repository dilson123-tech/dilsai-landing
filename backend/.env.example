# DilsAI Estudos — Backend environment

APP_NAME="DilsAI Estudos API"
APP_ENV=development
APP_VERSION=0.1.0

# CORS: separar por vírgula
CORS_ALLOW_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5173,http://127.0.0.1:5173,https://dilson123-tech.github.io

# LLM
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=900

# Nunca commitar chave real
OPENAI_API_KEY=
